{
  "name": "unen-portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/finalize.mjs",
    "preview": "astro preview",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "resume": "node scripts/export-resume.mjs",
    "release": "npm run build && npm run resume && npm run audit && npm run test:browser && npm run test:architecture",
    "export:preview": "node scripts/export-preview.mjs",
    "og": "node scripts/export-og.mjs",
    "prebuild": "npm run diagrams && npm run og",
    "diagrams": "node scripts/build-architectures.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:architecture": "node scripts/check-architecture-browser.mjs"
  },
  "dependencies": { "astro": "7.3.5", "@astrojs/mdx": "8.0.2" },
  "devDependencies": { "@astrojs/check": "0.9.10", "typescript": "6.0.3", "playwright": "1.58.2" }
}
