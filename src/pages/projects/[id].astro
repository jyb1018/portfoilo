---
import {getCollection,render} from 'astro:content';
import profile from '../../../content/profile.json';
import settings from '../../../site.config.json';
import {projectStart,projectEnd} from '../../lib/render.mjs';
export async function getStaticPaths(){
 const entries=await getCollection('projects');
 return entries.map(entry=>({params:{id:entry.data.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const projects=(await getCollection('projects')).map(p=>p.data).sort((a,b)=>a.order-b.order);
const config={...settings,site:Astro.site?.origin||settings.site,base:import.meta.env.BASE_URL};
---
<Fragment set:html={projectStart(profile,entry.data,config)} />
<Content />
<Fragment set:html={projectEnd(profile,entry.data,projects,config)} />
